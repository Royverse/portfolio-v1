{
  "name": "roy-mootsana-portfolio",
  "version": "1.0.0",
  "description": "Roy Mootsana — Software Engineer & UX Architect Portfolio",
  "homepage": "https://roymootsana.art",
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "parcel src/index.html --public-url /",
    "prebuild": "node -e \"const fs=require('fs'),p=require('path');if(fs.existsSync('dist'))for(const n of fs.readdirSync('dist'))if(n!=='.netlify')fs.rmSync(p.join('dist',n),{recursive:true,force:true})\"",
    "build": "parcel build src/index.html --public-url /",
    "build:gh-pages": "parcel build src/index.html --public-url /portfolio-v1/",
    "postbuild": "copy src\\robots.txt dist\\robots.txt && copy src\\sitemap.xml dist\\sitemap.xml && copy src\\favicon.ico dist\\favicon.ico && copy src\\favicon.png dist\\favicon.png && copy src\\favicon.svg dist\\favicon.svg && copy src\\Assets\\Images\\Portrait\\portrait-2.jpg dist\\portrait-2.jpg && copy src\\_headers dist\\_headers"
  },
  "alias": {
    "lottie-web": "lottie-web/build/player/lottie_light.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Royverse/portfolio-v1.git"
  },
  "author": "Roy Mootsana",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Royverse/portfolio-v1/issues"
  },
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.16.4",
    "@parcel/packager-xml": "^2.16.4",
    "@parcel/transformer-jsonld": "^2.16.4",
    "@parcel/transformer-webmanifest": "^2.16.4",
    "@parcel/transformer-xml": "^2.16.4",
    "babel-eslint": "^10.0.1",
    "eslint": "^5.8.0",
    "eslint-config-airbnb": "^17.1.0",
    "eslint-plugin-import": "^2.14.0",
    "eslint-plugin-jsx-a11y": "^6.1.2",
    "eslint-plugin-react": "^7.11.1",
    "gh-pages": "^5.0.0",
    "parcel": "^2.16.4"
  },
  "dependencies": {
    "framer-motion": "^4.1.17",
    "gsap": "^3.15.0",
    "lottie-react": "^2.4.1",
    "prop-types": "^15.6.2",
    "react": "^16.6.3",
    "react-dom": "^16.6.0",
    "react-responsive": "^6.0.1",
    "styled-components": "^4.0.3",
    "vh-check": "^2.0.5"
  },
  "browserslist": [
    "> 0.25%",
    "chrome >= 50",
    "safari >= 10",
    "firefox >= 45",
    "ios >= 10",
    "not dead"
  ]
}
